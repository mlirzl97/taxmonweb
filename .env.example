# Required for authenticated local/preview use. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional Sentry DSNs. Leave unset to keep observability disabled locally.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Keep local/preview setup synthetic-only. Set to production only after approved data controls exist.
TAXMON_DATA_MODE=sanitized
# Temporary calibration mode only. Keep false before real client data is used.
TAXMON_DEMO_MODE=false
# Temporary sanitized-prototype calibration only. Enables local profile/setup
# edits using browser-persisted fixture state; never enable for real client data.
TAXMON_CALIBRATION_EDIT_MODE=false
